  RowID   BigInt    @id(map: "PK_WhFiles") @default(autoincrement())
  RowName String?   @db.NVarChar(50)
  Files   Bytes?    @db.Image
  Mdate   DateTime?
  RowDesc String?   @db.NText
  WhID    Int?
  WhDocH  WhDocH?   @relation(fields: [WhID], references: [RowID], onDelete: NoAction, onUpdate: NoAction, map: "FK_WhFiles_WhDocH")

  @@schema("dbo")
}

model WorkstationNode {
  Id                 Int                  @id(map: "PK_dbo.WorkstationNode")
  IPAddress          String               @db.NVarChar(20)
  Port               Int
  Description        String?              @db.NVarChar(300)
  BranchID           Int?
  ReversionScale     BigInt?
  Reversion          BigInt?
  Types              Int?
  WorkstationRequest WorkstationRequest[]

  @@schema("dbo")
}

model WorkstationRequest {
  WorkstationId   Int
  RequestId       Int
  RequestStatusId Int
  Request         Request         @relation(fields: [RequestId], references: [Id], onUpdate: NoAction, map: "FK_dbo.WorkstationRequest_dbo.Request_RequestId")
  RequestStatus   RequestStatus   @relation(fields: [RequestStatusId], references: [Id], onUpdate: NoAction, map: "FK_dbo.WorkstationRequest_dbo.RequestStatus_RequestStatusId")
  WorkstationNode WorkstationNode @relation(fields: [WorkstationId], references: [Id], onUpdate: NoAction, map: "FK_dbo.WorkstationRequest_dbo.WorkstationNode_WorkstationId")

  @@id([WorkstationId, RequestId], map: "PK_dbo.WorkstationRequest")
  @@schema("dbo")
}
